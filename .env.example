# Copy to .env and adjust if ports 3000/3001 fail on your PC (common on Windows
# when Hyper-V or Docker reserves port ranges).

# Nuxt dev server port (default 3000; Nuxt picks another if busy)
# PORT=3000

# Serial-server HTTP API (default 3001; auto-probes 3002+ if blocked)
# SERIAL_SERVER_PORT=3001
# NUXT_SERIAL_SERVER_URL=http://127.0.0.1:3001

# LAN access — comma-separated IPs/CIDRs (default loopback only)
# ALLOWED_IPS=127.0.0.1/8,::1,192.168.1.0/24
#
# When ALLOWED_IPS includes a LAN range, Nuxt binds 0.0.0.0 (see nuxt.config.ts).
# Use http://127.0.0.1:3000 on the same PC if the LAN URL fails before a restart.

# Dev: virtual radio port in the port list
# SIMULATE_RIG=1
